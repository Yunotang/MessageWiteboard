rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'hoyoboy0726@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /messages/{messageId} {
      allow read: if true;
      
      allow create: if isValidId(messageId) &&
                       ((isSignedIn() && incoming().authorId == request.auth.uid) || (!isSignedIn() && incoming().authorId == 'anonymous')) &&
                       incoming().text is string &&
                       incoming().text.size() > 0 &&
                       incoming().text.size() <= 1000 &&
                       incoming().authorName is string &&
                       incoming().authorName.size() <= 100 &&
                       (!incoming().keys().hasAll(['authorPhotoUrl']) || incoming().authorPhotoUrl is string) &&
                       incoming().color in ['bg-yellow-200', 'bg-pink-200', 'bg-blue-200', 'bg-green-200', 'bg-purple-200'];


                       
      allow update: if isSignedIn() &&
                       isValidId(messageId) &&
                       incoming().authorId == existing().authorId && // Must not change authorId
                       incoming().authorName == existing().authorName && // Must not change authorName
                       (
                         // Case 1: Author updating message
                         (request.auth.uid == existing().authorId &&
                          incoming().text is string &&
                          incoming().text.size() > 0 &&
                          incoming().text.size() <= 1000 &&
                          incoming().color in ['bg-yellow-200', 'bg-pink-200', 'bg-blue-200', 'bg-green-200', 'bg-purple-200'])
                         ||
                         // Case 2: Anyone updating likes and replies (leaving text/color alone)
                         (incoming().text == existing().text &&
                          incoming().color == existing().color &&
                          (!existing().keys().hasAll(['authorPhotoUrl']) || incoming().authorPhotoUrl == existing().authorPhotoUrl) &&
                          (!incoming().keys().hasAll(['likes']) || incoming().likes is list) &&
                          (!incoming().keys().hasAll(['replies']) || incoming().replies is list))
                       );
                       
      allow delete: if isSignedIn() &&
                       isValidId(messageId) &&
                       (existing().authorId == request.auth.uid || isAdmin());
    }
  }
}
